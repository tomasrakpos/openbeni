# Server-only environment variables (Cloudflare Pages Secrets / Environment Variables)
# NEVER prefix server secrets with VITE_.

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel & encryption (server-side)
ADMIN_EMAILS=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
MASTER_ENCRYPTION_KEY=

# CORS & BYOK proxy hardening (server-side)
ALLOWED_ORIGIN=
ALLOWED_HOSTS=
PROXY_TOKEN=

# Optional Coarena pool (server-side)
COARENA_KEYS=
COARENA_BASE_URL=

# External Skills System (server-side, all optional — defaults live in skills/skills.config.json)
# Classifier model (fast/cheap LLM returning strict JSON category)
SKILL_CLASSIFIER_MODEL=gpt-4o-mini
SKILL_CLASSIFIER_BASE_URL=
SKILL_CLASSIFIER_API_KEY=
SKILL_CLASSIFIER_API_FORMAT=openai
SKILL_CLASSIFIER_TIMEOUT_MS=4500
# Per-request skill token budget (default: 14000)
SKILL_MAX_TOKENS=14000
# Injection mode: "direct" (Mode A, default) or "tool" (Mode B read_skill tool for tool-capable models)
SKILL_DEFAULT_MODE=direct
# Optional JSON overrides per provider format or model id, e.g. {"openai":"tool","anthropic":"tool"}
SKILL_PROVIDER_MODES=
SKILL_MODEL_MODES=

# Browser-visible variables (Cloudflare Pages Build Environment Variables)
# Public by design — ONLY put the Supabase anon key here, NEVER the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DOCS_URL=
