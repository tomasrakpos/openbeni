# Server-only settings for the same-origin API handlers.
# Copy this file to `.env` (git-ignored) and fill in real values.
# NEVER prefix a secret with VITE_ — that would ship it to the browser bundle.
# The two public VITE_ values at the bottom are the exception: the anon key is
# designed to be public.

# ── Legacy Coarena pool (kept for the existing bundled gateway) ──────────────
# Comma-separated Coarena keys. The server rotates them automatically.
COARENA_KEYS=
COARENA_BASE_URL=https://coarena.ai/api/v1

# ── CORS / proxy hardening ──────────────────────────────────────────────────
# CORS allowlist for the same-origin APIs (comma separated).
# Leave empty to accept the deployment's own origin plus localhost in dev.
ALLOWED_ORIGIN=
# Optional host allowlist for the generic BYOK proxy.
ALLOWED_HOSTS=
# Optional shared secret for /api/proxy (sent as the x-proxy-token header).
PROXY_TOKEN=

# ── Supabase (server only) ──────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Used by the server to verify access tokens against /auth/v1/user.
SUPABASE_ANON_KEY=
# SERVICE ROLE — full database access. Server only, never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that are always administrators.
# Example: ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

# Password for the standalone /admin page (minimum 8 characters).
# This is the ONLY way into the panel; the public site never links to it.
# If unset, the admin endpoints answer 503 and the panel stays locked.
ADMIN_PASSWORD=
# Optional separate HMAC key for admin session tokens. If empty, the password
# itself signs the tokens (rotating the password then revokes all sessions).
ADMIN_SESSION_SECRET=

# AES-256-GCM master key used to encrypt provider API keys at rest.
# Generate one with:  openssl rand -base64 32
# Losing it means existing stored keys can no longer be decrypted.
MASTER_ENCRYPTION_KEY=

# ── Browser-visible Supabase config (public by design) ──────────────────────
# These go into the built bundle. Only ever use the *anon* key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
